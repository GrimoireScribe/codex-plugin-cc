{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "review_evidence",
    "findings",
    "pre_existing_observations",
    "next_steps"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "needs-attention"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "review_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "files_examined",
        "checks_performed",
        "tools_used",
        "limitations"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "provided-diff-only",
            "provided-artifact-only",
            "targeted-repository",
            "repository-wide"
          ]
        },
        "files_examined": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks_performed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "evidence"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "tools_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "body",
          "file",
          "line_start",
          "line_end",
          "confidence",
          "severity_rationale",
          "corrective_invariant",
          "recommendation",
          "fix_confidence",
          "trigger_conditions",
          "authorship",
          "authorship_evidence",
          "exposure",
          "exposure_evidence"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "severity_rationale": {
            "type": "string",
            "minLength": 1
          },
          "corrective_invariant": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "fix_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "trigger_conditions": {
            "type": "string",
            "minLength": 1
          },
          "authorship": {
            "type": "string",
            "enum": [
              "introduced",
              "pre-existing",
              "unverified"
            ]
          },
          "authorship_evidence": {
            "type": "string",
            "minLength": 1
          },
          "exposure": {
            "type": "string",
            "enum": [
              "change-touches-property",
              "untouched",
              "not-applicable"
            ]
          },
          "exposure_evidence": {
            "type": "string"
          }
        }
      }
    },
    "pre_existing_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line",
          "note"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
